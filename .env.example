# Build-time settings for production builds (`bun run build`, Cloudflare Pages).
# Local `bun run dev` defaults to the `plat5 start` operator stack below.
# The container image takes the same settings at start without VITE_ (see README).

# Required for `bun run build`. Operator gateway origin. ALLOWED_ORIGINS must include this console's origin.
VITE_GATEWAY_URL=http://localhost:5410

# Required for `bun run build`. Operator IdP (OIDC, or OAuth 2.0 metadata like Plat5 Auth). Must equal gateway AUTH_ISSUER.
VITE_AUTH_ISSUER=http://localhost:5411

# Required for `bun run build`. Public client id (no secret, PKCE, <origin>/callback redirect URI).
VITE_AUTH_CLIENT_ID=operator-console

# Optional. Default "openid email profile".
# VITE_AUTH_SCOPES=openid email profile

# Optional. Only for IdPs that take an audience on /authorize (e.g. Auth0).
# VITE_AUTH_AUDIENCE=
